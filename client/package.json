{
  "name": "rod-game-client",
  "version": "0.1.0",
  "private": true,
  "description": "ROD — Illustrated Turn-Based RPG Game Client",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:electron && npm run build:ui",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^35.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
